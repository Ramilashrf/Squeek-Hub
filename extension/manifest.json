{
  "manifest_version": 3,
  "name": "Squeek Hub",
  "version": "1.1.1",
  "description": "Put the live Squeektoshi wheel card in a floating window.",
  "minimum_chrome_version": "116",
  "host_permissions": ["https://api.squeekchain.com/*"],
  "action": {"default_title": "Squeek Hub"},
  "background": {"service_worker": "background.js"}
}
